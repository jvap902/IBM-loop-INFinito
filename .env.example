# ============================================================
#  Telecom AI Platform — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit the .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Storage paths (local dev / MinIO mount)
# ----------------------------------------------------------
BRONZE_DIR=/data/bronze
GOLD_DIR=/data/gold

# ----------------------------------------------------------
# Ookla Speedtest Open Data
# ----------------------------------------------------------
# Year and quarter to ingest (auto-computed by DAG if omitted)
OOKLA_YEAR=2024
OOKLA_QUARTER=1

# ----------------------------------------------------------
# IBGE
# ----------------------------------------------------------
# Set to a UF code (e.g. "35" for São Paulo) to restrict CNEFE download.
# Leave empty to download all of Brazil.
IBGE_UF_FILTER=

# Override the default CNEFE Parquet download URL if needed
# IBGE_CNEFE_URL=https://censo2022.ibge.gov.br/...

# ----------------------------------------------------------
# Anatel
# ----------------------------------------------------------
# ANATEL_SCM_URL=https://...
# ANATEL_SMP_URL=https://...
# ANATEL_RECLAM_URL=https://...
# ANATEL_MOSAICO_URL=https://...

# ----------------------------------------------------------
# OpenCelliD  (required for n_erb supplement)
# ----------------------------------------------------------
# Register at https://opencellid.org to obtain a token
OPENCELLID_API_KEY=your_opencellid_api_key_here

# ----------------------------------------------------------
# M-Lab NDT (BigQuery)
# ----------------------------------------------------------
# GCP project that will be billed for BigQuery queries
GCP_PROJECT=your-gcp-project-id
# Path to a GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# Number of days to look back in each NDT ingestion run
MLAB_DATE_RANGE_DAYS=30

# ----------------------------------------------------------
# Cloudflare Radar
# ----------------------------------------------------------
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Required scopes: "Radar read" (read-only)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Number of days to fetch per run
CLOUDFLARE_DATE_RANGE_DAYS=30

# ----------------------------------------------------------
# Airflow
# ----------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__LOGGING__LOG_LEVEL=INFO

# ----------------------------------------------------------
# Sub-Task 4 — Tool API Layer
# ----------------------------------------------------------
# Comma-separated list of valid API keys (preferred over single TOOL_API_KEY)
# TOOL_API_KEYS=key-one,key-two,key-three

# Single API key fallback (legacy / simple dev setup)
# TOOL_API_KEY=change-me-in-production

# Path to the Gold Feature Store Parquet file produced by Sub-Task 1
# GOLD_PARQUET_PATH=data/gold/features.parquet

# Python log level for the API service (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO

# API version string embedded in responses and OpenAPI metadata
# API_VERSION=1.0.0

# Comma-separated allowed CORS origins (* = allow all, restrict in production)
# When running the web UI in development, include the Vite dev server origin:
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=http://localhost:3000,https://dashboard.internal

# ----------------------------------------------------------
# Sub-Task 5 — Audit & Transparency Layer
# ----------------------------------------------------------
# Backend de persistência: jsonl (padrão, local) | postgres (produção)
# AUDIT_BACKEND=jsonl

# Caminho do arquivo de log JSONL (usado quando AUDIT_BACKEND=jsonl)
# AUDIT_JSONL_PATH=logs/audit.jsonl

# DSN do PostgreSQL (usado apenas quando AUDIT_BACKEND=postgres)
# AUDIT_DB_DSN=postgresql://user:password@localhost:5432/telecom_audit

# ----------------------------------------------------------
# Sub-Task 6 — Operational Agent (LangGraph)
# ----------------------------------------------------------
# LLM provider: watsonx | openai | gemini | stub (default: stub)
# LLM_PROVIDER=stub

# IBM watsonx.ai (required when LLM_PROVIDER=watsonx)
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# OpenAI GPT-4o (required when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=gpt-4o

# Google Gemini (required when LLM_PROVIDER=gemini)
# SDK:  pip install google-genai   (NÃO use google-generativeai — foi descontinuado)
# Chave gratuita em: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.5-flash

# Tool API base URL (used by agent to call the FastAPI service)
# TOOL_API_BASE_URL=http://localhost:8000

# Maximum seconds the /v1/agent/run BFF endpoint waits for the agent to finish.
# Increase for large datasets or slow LLM providers. HTTP 504 is returned on timeout.
# AGENT_RUN_TIMEOUT_SECONDS=120

# TAM calculation parameters
# AGENT_ARPU_BRL=89.90
# AGENT_PENETRATION_RATE=0.35

# MLflow tracking URI (optional)
# MLFLOW_TRACKING_URI=http://localhost:5000